<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

use Symfony\Component\HttpFoundation\RedirectResponse;

/**
 * @implements hook_page_attachments()
 *
  if (!\Drupal::currentUser()->hasPermission('access contextual links')) {
  }
 */
function manageinfo_page_attachments(array &$page) {
  $path_args = \Drupal::service('flexinfo.setting.service')
    ->getCurrentPathArgs();
  if (strtolower($path_args[2]) == 'manageinfo') {
    $page['#attached']['library'][] = 'manageinfo/add_coordinate';
    $page['#attached']['library'][] = 'manageinfo/google_geocode';
  }
}

/**
 * Implements hook_entity_insert().
 *
 * Inserts nodes properly based on generation options.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 */
function manageinfo_entity_insert(EntityInterface $entity) {
  if ($entity->getEntityTypeId() == 'node') {
    if ($entity->bundle() == 'meeting') {
      _manageinfo_node_meeting_redirect($entity->id());
    }
  }

  return;
}

/**
 * Implements hook_entity_update().
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 */
function manageinfo_entity_update(EntityInterface $entity) {
  if ($entity->getEntityTypeId() == 'node') {
    if ($entity->bundle() == 'meeting') {
      _manageinfo_node_meeting_redirect($entity->id());
    }
  }

  return;
}

/**
 *
 */
function _manageinfo_node_meeting_redirect($nid = NULL) {
  $uri = '/manageinfo/redirect/meetinginsert/' . $nid;
  $url = Url::fromUserInput($uri)->toString();

  $response = new RedirectResponse($url);
  $response->send();

  return;
}

/**
 * Implements hook_form_alter().
 * Implements hook_form_FORM_ID_alter().
 */
function manageinfo_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Alter form and add own custom submit handler.
  if ($form_id == 'taxonomy_term_questionlibrary_form') {
    $form['actions']['submit']['#submit'][] = '_manageinfo_form_submit_common_handler';
  }
}

/**
 * Custom submit handler for common form.
 */
function _manageinfo_form_submit_common_handler($form, FormStateInterface $form_state) {
  $url_path = '/ngpage/standardterm/page/questionlibrary';
  $url = Url::fromUserInput($url_path);

  $request = \Drupal::service('request_stack')->getCurrentRequest();
  if (!$request->request->has('destination')) {
    $form_state->setRedirectUrl($url);
  }
  else {
    $form_state->setRedirect('<front>');
  }
}

