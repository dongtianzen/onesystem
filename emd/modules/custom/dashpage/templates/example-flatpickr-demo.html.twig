{#
 # Let's output the four variables to this template, three variables are from controller
 # The four variable is from default value on the hook_theme()
#}
<div class="margin-top-36 margin-left-32 margin-right-32">
  <div class="panel panel-default">
    <div class="panel-heading">
      <h3 class="panel-title">Flatpickr Demo</h3>
    </div>
    <div class="panel-body">
      <div class="dropdown">
        <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
          Date Range
          <span class="caret"></span>
        </button>
        <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
          <li style="width:600px;">
            <div class="row">
              <div class="col-xs-6 col-xs-offset-1">
                <div class="flatpickr-wrapper">
                  <input class="flatpickr-container" type="text" placeholder="Select Date.." data-id="datetime" readonly="readonly" style="width:300px;">
                </div>
              </div>
              <div class="col-xs-5">
                <div class="ranges">
                  <ul style="margin: 36px;">
                    <li data-range-key="2022 Year" style="padding: 6px;">
                      <a href="#">
                        2022 Year
                      </a>
                    </li>
                    <li data-range-key="YTD" style="padding: 6px;">
                      <a href="#">
                        YTD
                      </a>
                    </li>
                    <li data-range-key="2023 Q1" style="padding: 6px;">
                      <a href="#">
                        2023 Q1
                      </a>
                    </li>
                    <li data-range-key="Custom Range" style="padding: 6px;">
                      <a href="#">
                        Apply Custom Range
                      </a>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
