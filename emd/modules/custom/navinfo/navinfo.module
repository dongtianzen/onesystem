<?php

use Drupal\Core\Form\FormStateInterface;

use Drupal\Core\Url;

use Drupal\navinfo\Content\NavinfoFormAlter;

/**
 * @implements hook_form_alter().
 */
function navinfo_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id == 'user_form') {
    $current_user = \Drupal\user\Entity\User::load(\Drupal::currentUser()->id());

    $form['#attributes']['class'][] = 'width-500';

    // only disable edit form
    if ($form['account']['mail']['#default_value'] && !$current_user->hasRole('administrator')) {
      $form['account']['name']['#attributes']['disabled'] = 'disabled';
      $form['account']['name']['#attributes']['readonly'] = 'readonly';
      $form['account']['mail']['#attributes']['disabled'] = 'disabled';
      $form['account']['mail']['#attributes']['readonly'] = 'readonly';
    }

    if ($current_user->hasRole('siteadmin') || $current_user->hasRole('administrator')) {
    }
    else {
      $form['account']['roles']['#access'] = FALSE;
      $form['account']['status']['#access'] = FALSE;
    }

    // disable hide
    $form['account']['notify']['#access'] = FALSE;

    $form['user_picture']['#access'] = FALSE;
    $form['contact']['#access'] = FALSE;
  }
}

/**
 * @implements hook_form_FORM_ID_alter().
 */
function navinfo_form_contact_message_feedback_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $NavinfoFormAlter = new NavinfoFormAlter();

  $form['name']['#prefix'] = $NavinfoFormAlter->contactMessageFeedbackFormNamePrefix();

  $form['name']['#type'] = 'hidden';
  $form['copy']['#type'] = 'hidden';
}

/**
 * @implements hook_form_FORM_ID_alter().
 */
function navinfo_form_user_login_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Alter login form and add own custom submit handler.
  $form['#submit'][] = '_navinfo_user_login_form_submit';
}

/**
 * Custom submit handler for login form.
 */
function _navinfo_user_login_form_submit($form, FormStateInterface $form_state) {
  $start = \Drupal::service('flexinfo.setting.service')->userStartTime();
  $end   = \Drupal::service('flexinfo.setting.service')->userEndTime();

  $url_path = '/ngpage/dashboard/page/all/' . $start . '/' . $end;
  $url = Url::fromUserInput($url_path);

  // Check if a destination was set, probably on an exception controller.
  // @see \Drupal\user\Form\UserLoginForm::submitForm()
  $request = \Drupal::service('request_stack')->getCurrentRequest();
  if (!$request->request->has('destination')) {
    $form_state->setRedirectUrl($url);
  }
  else {
    $request->query->set('destination', $request->request->get('destination'));
  }
}
