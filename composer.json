{
    "name": "drupal-composer/drupal-project",
    "description": "Project template for Drupal 8 projects with composer",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "",
            "role": ""
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": "^7.4|^8.1",
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.6",
        "defuse/php-encryption": "^2.2",
        "doctrine/annotations": "^2.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/bootstrap_barrio": "^5.5",
        "drupal/config_ignore": "^3.4",
        "drupal/core": "^10.6.13",
        "drupal/core-composer-scaffold": "^10.6.13",
        "drupal/core-project-message": "^10.6.13",
        "drupal/core-recommended": "^10.6.13",
        "drupal/field_group": "^3.6",
        "drupal/gin": "^3.0@RC",
        "drupal/paragraphs": "^1.21",
        "drupal/role_delegation": "^1.0@alpha",
        "drupal/simple_sitemap": "^4.2.2",
        "drupal/superfish": "^1.3",
        "drupal/twig_tweak": "^3.2",
        "drupal/upgrade_status": "^4.3",
        "drupal/userprotect": "^1.0",
        "drupal/views_slideshow": "^5.0",
        "drush/drush": "^12",
        "laminas/laminas-feed": "^2.20",
        "nikic/php-parser": "^4.0",
        "psr/container": "^2.0",
        "typo3/phar-stream-wrapper": "^3.1.4",
        "vlucas/phpdotenv": "^2.4",
        "webflo/drupal-finder": "^1.2.2",
        "webmozart/path-util": "^2.3"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ],
        "files": ["load.environment.php"]
    },
    "scripts": {
        "drupal-scaffold": "DrupalComposer\\DrupalScaffold\\Plugin::scaffold",
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ]
    },
    "extra": {
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/contrib/{$name}": ["type:drupal-drush"]
        }
    },
    "require-dev": {
        "drupal/core-dev": "^10.6"
    }
}
