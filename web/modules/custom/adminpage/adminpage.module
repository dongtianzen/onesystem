<?php

/**
 * @file
 * Admin overview page.
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function adminpage_help($route_name, RouteMatchInterface $route_match) {
  if ($route_name === 'help.page.adminpage') {
    return '<h3>' . t('About') . '</h3><p>' . t('Shortcuts to manage content, FAQs, users and taxonomy terms.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function adminpage_theme(): array {
  return [
    'adminpage_overview' => [
      'variables' => [
        'sections' => [],
        'taxonomy_title' => NULL,
        'vocabularies' => [],
        'empty' => NULL,
      ],
    ],
  ];
}
