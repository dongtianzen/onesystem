# Chinese (Simplified) translation of ob_faq
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Import FAQs"
msgstr "导入 FAQ"

msgid "Import FAQ nodes from JSON."
msgstr "从 JSON 导入 FAQ。"

msgid "Bulk import"
msgstr "批量导入"

msgid "Single import"
msgstr "单条导入"

msgid "Create FAQ"
msgstr "新建 FAQ"

msgid "A JSON list of FAQs, or {\"faqs\": [...]}. Max 5 MB."
msgstr "FAQ 的 JSON 列表，或 {\"faqs\": [...]}。最大 5 MB。"

msgid "An FAQ exists when \"nid\" is given, or when a FAQ with the same Chinese question exists. Unchecked: existing FAQs are skipped."
msgstr "填了 \"nid\"，或已有相同中文问题的 FAQ，即视为已存在。不勾选时跳过已存在的 FAQ。"

msgid "Device term IDs"
msgstr "设备 term ID"

msgid "FAQ JSON"
msgstr "FAQ JSON"

msgid "FAQ nid"
msgstr "FAQ nid"

msgid "Found @n items. Paste exactly one, or use the Bulk tab."
msgstr "找到 @n 条。请只粘贴一条，多条请用「批量导入」。"

msgid "Import"
msgstr "导入"

msgid "Import result"
msgstr "导入结果"

msgid "Imported @n items."
msgstr "已导入 @n 条。"

msgid "Imported with errors: @n items, @e errors."
msgstr "导入完成但有错误：共 @n 条，@e 条出错。"

msgid "Item"
msgstr "条目"

msgid "JSON file"
msgstr "JSON 文件"

msgid "Loaded: @n items. Leave empty to import the loaded file."
msgstr "已载入 @n 条。不选新文件则导入已载入的内容。"

msgid "No FAQ items found."
msgstr "没有找到 FAQ 条目。"

msgid "One FAQ object. Add \"nid\" to update a specific FAQ. Use the Bulk tab for several FAQs."
msgstr "一条 FAQ 的 JSON 对象。加上 \"nid\" 可更新指定的 FAQ。多条请用「批量导入」。"

msgid "Please choose a JSON file."
msgstr "请选择 JSON 文件。"

msgid "Please upload a .json file."
msgstr "请上传 .json 文件。"

msgid "Preview"
msgstr "预览"

msgid "Preview result"
msgstr "预览结果"

msgid "Preview: @n items, @e errors. Nothing was saved."
msgstr "预览：共 @n 条，@e 条出错。未保存任何内容。"

msgid "Result"
msgstr "结果"

msgid "The file is larger than 5 MB."
msgstr "文件超过 5 MB。"

msgid "Update FAQs that already exist"
msgstr "更新已存在的 FAQ"

msgid "Export products"
msgstr "导出产品内容"

msgid "Download the text of published product and solution pages as JSON, for drafting FAQs. The file also lists existing FAQs so drafts can avoid duplicates."
msgstr "把已发布的产品和方案页面文字下载为 JSON，用于起草 FAQ。文件里也包含现有 FAQ 列表，避免生成重复问题。"

msgid "Product and solution pages: @n"
msgstr "产品和方案页面：@n"

msgid "Pages with a device term: @n"
msgstr "有设备 term 的页面：@n"

msgid "Existing FAQs: @n"
msgstr "现有 FAQ：@n"

msgid "Download pages with a device term"
msgstr "下载有设备的页面"

msgid "Download all pages"
msgstr "下载全部页面"

msgid "Sample JSON (click to select, then copy)"
msgstr "示例 JSON（点击全选后复制）"

msgid "Fields"
msgstr "字段说明"

msgid "<code>category</code>: FAQ category name (Chinese or English). Options: @list. Optional."
msgstr "<code>category</code>：FAQ 分类名称（中文或英文均可）。可选值：@list。可省略。"

msgid "<code>status</code>: <code>draft</code> (unpublished, default) or <code>published</code>."
msgstr "<code>status</code>：<code>draft</code>（未发布，默认）或 <code>published</code>（发布）。"

msgid "<code>translations</code>: <code>zh-hans</code> is required, <code>en</code> is optional. Each language needs <code>question</code> and <code>answer</code>. Answers can be plain text; separate paragraphs with a blank line."
msgstr "<code>translations</code>：<code>zh-hans</code> 必填，<code>en</code> 可省略。每种语言都要有 <code>question</code>（问题）和 <code>answer</code>（答案）。答案可写纯文本，空一行表示分段。"

msgid "<code>device_terms</code>: device term IDs or names, one or more, e.g. <code>[152]</code> or <code>[\"LiveU LU800\"]</code>. Use the term ID when several devices share a name."
msgstr "<code>device_terms</code>：设备 term 的 tid 或名称，可填多个，如 <code>[152]</code> 或 <code>[\"LiveU LU800\"]</code>。有重名设备时请用 tid。"

msgid "<code>products</code>: optional list of product page node IDs, e.g. <code>[250]</code>. If <code>device_terms</code> is omitted, the devices of these pages are used."
msgstr "<code>products</code>：可选，产品页的 nid 列表，如 <code>[250]</code>。不写 <code>device_terms</code> 时，使用这些页面的设备。"

msgid "<code>nid</code>: optional. Updates that FAQ instead of creating a new one (tick \"Update FAQs that already exist\")."
msgstr "<code>nid</code>：可选。填写后更新这条 FAQ 而不是新建（需勾选「更新已存在的 FAQ」）。"
